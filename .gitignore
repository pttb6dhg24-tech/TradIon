# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Modelos descargados (pesan GB, nunca al repo)
models/*
!models/.gitkeep

# Sistema
.DS_Store

# Audio temporal
*.wav
*.tmp

# Credenciales y Certificados (Seguridad)
# OJO: la clave privada TLS se commiteó una vez (7ff4152) y hubo que rotarla —
# el directorio ENTERO queda vetado, no solo las extensiones
config/certs/
*.pem
*.key
*.crt
*.p12
.env
.env.*

# Huellas vocales temporales (biométricas: JAMÁS al repo)
models/tmp/

# ---------------------------------------------------------------------------
# MATERIAL INTERNO — el repositorio documenta el SOFTWARE, nunca el NEGOCIO.
# Estrategia comercial, precios, guiones de vídeo, material de venta y notas
# de financiación viven FUERA del repositorio (~/Documents/TradIon-privado/).
# Se publicó una vez una estrategia de monetización con precios y hubo que
# purgar el historial: estas reglas son la red de seguridad, no la política.
# ---------------------------------------------------------------------------
docs/privado/
docs/ESTRATEGIA*.md
docs/VIDEO*.md
docs/*PRECIOS*
docs/*NEGOCIO*

# Herramientas de asistentes de IA: configuración local y árboles de trabajo,
# específicos de una máquina y sin valor para quien clone el repositorio
.claude/
